rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read and write their own progress document.
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['progress', 'updatedAtMs', 'updatedAt'])
        && request.resource.data.progress is map
        && request.resource.data.updatedAtMs is number;
    }
  }
}
